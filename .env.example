# PULSO MVP - Environment Variables Example
# Copy these files and update with your actual values:
# - frontend/.env.local
# - backend/.env.local

# ============================================================================
# FRONTEND (.env.local)
# ============================================================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-in-production


# ============================================================================
# BACKEND (.env.local)
# ============================================================================

# Database Configuration
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:pass@localhost:5432/pulso

# API Keys and Secrets
# Get Claude API key from https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your-key-here

# JWT secret for token signing (change in production!)
JWT_SECRET=your-secret-key-change-in-production

# Application URLs
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Application Settings
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO


# ============================================================================
# PRODUCTION NOTES
# ============================================================================
#
# For production deployments:
#
# 1. Frontend:
#    - Change NEXTAUTH_URL to your production domain
#    - Change NEXTAUTH_SECRET to a strong random key (openssl rand -base64 32)
#    - Change NEXT_PUBLIC_API_URL to your production API URL
#
# 2. Backend:
#    - Change DATABASE_URL to production PostgreSQL
#    - Change JWT_SECRET to a strong random key
#    - Change FRONTEND_URL to production domain
#    - Set ENVIRONMENT=production
#    - Set DEBUG=false
#    - Add actual CLAUDE_API_KEY from Anthropic
#
# 3. Security:
#    - Never commit .env files with secrets to git
#    - Use environment variables from your hosting platform
#    - Rotate secrets regularly
